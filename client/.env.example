# URL of the API. Leave empty in development (Vite proxies /api to localhost:4000).
# Production example: https://rise-api.onrender.com
VITE_API_URL=

# Public site URL, used for canonical/OG tags
VITE_SITE_URL=http://localhost:5173

# Givebutter account ID (fallback if not set in admin Settings)
VITE_GIVEBUTTER_ACCOUNT_ID=
