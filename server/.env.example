# ─── Core ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/rise
# Long random string (openssl rand -hex 32). REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for Cloudinary notification webhooks + sitemap)
SERVER_URL=http://localhost:4000
# Public URL of the website (used in emails + sitemap)
SITE_URL=http://localhost:5173

# ─── First admin (created by `npm run seed`) ───────
ADMIN_EMAIL=owner@rise.org
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=RISE Owner

# ─── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (any SMTP: Resend, Postmark, Gmail…) ────
# Resend SMTP: host smtp.resend.com, port 465, user "resend", pass = API key
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RISE <no-reply@rise.org>"
# Fallback notification address if not set in admin Settings
NOTIFICATION_EMAIL=

# ─── Payments ──────────────────────────────────────
# Fallback if the Zeffy URL is not set in admin Settings
ZEFFY_DONATION_FORM_URL=https://www.zeffy.com/embed/donation-form/your-form-slug
# Shared secret sent by Zapier as the "x-webhook-secret" header
ZEFFY_WEBHOOK_SECRET=
# Givebutter webhook signing secret
GIVEBUTTER_WEBHOOK_SECRET=
